# PostgreSQL-Verbindung (Prisma). Lokal z.B. via `docker compose up db`.
DATABASE_URL=postgresql://prozess:prozess@localhost:5432/prozess?schema=public

# LLM-Provider: "groq"/"gemini" (kostenlos), "anthropic" (Cloud) oder "mock" (offline).
# Ohne passende Konfiguration fällt die App automatisch auf den nächsten
# verfügbaren Provider und zuletzt auf "mock" zurück.
LLM_PROVIDER=groq

# Groq (KOSTENLOSES Free-Tier, zuverlässig) — Key aus https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Free-Tier; bei Firmen-/Workspace-Accounts evtl. gesperrt -> privaten
# Google-Account nutzen) — Key aus https://aistudio.google.com ("Get API key")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude (Cloud, kostenpflichtig)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# On-Prem / beliebiges OpenAI-kompatibles Backend (vLLM / Ollama): LLM_PROVIDER=openai
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=llama3.1
# OPENAI_COMPAT_API_KEY=
