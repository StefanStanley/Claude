# PostgreSQL-Verbindung (Prisma). Lokal z.B. via `docker compose up db`.
DATABASE_URL=postgresql://prozess:prozess@localhost:5432/prozess?schema=public

# LLM-Provider-Auswahl: "anthropic" (Cloud) oder "mock" (offline, kein Key nötig)
# Ohne gesetzten ANTHROPIC_API_KEY fällt die App automatisch auf "mock" zurück.
LLM_PROVIDER=anthropic

# Anthropic (Cloud) — nur nötig, wenn LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Platzhalter für spätere On-Prem-Backends (OpenAI-kompatibel: vLLM / Ollama)
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODEL=llama-3.3-70b
