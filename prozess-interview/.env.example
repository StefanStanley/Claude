# PostgreSQL-Verbindung (Prisma). Lokal z.B. via `docker compose up db`.
DATABASE_URL=postgresql://prozess:prozess@localhost:5432/prozess?schema=public

# LLM-Provider-Auswahl: "anthropic" (Cloud), "gemini" (kostenlos) oder "mock" (offline).
# Ohne passenden API-Key fällt die App automatisch auf den nächsten verfügbaren
# Provider und zuletzt auf "mock" zurück.
LLM_PROVIDER=gemini

# Google Gemini (KOSTENLOSES Free-Tier) — Key aus https://aistudio.google.com ("Get API key")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude (Cloud, kostenpflichtig) — nur nötig, wenn LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Platzhalter für spätere On-Prem-Backends (OpenAI-kompatibel: vLLM / Ollama)
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODEL=llama-3.3-70b
